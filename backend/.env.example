# Base Settings
ENVIRONMENT=dev
DEBUG=true

# Database Settings
# For local dev: postgresql+asyncpg://<username>:<password>@localhost:5432/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oluora

# Resend settings (https://resend.com)
RESEND_API_KEY=re_placeholder_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Allowed CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000

# JWT Auth Settings
JWT_SECRET=super_secret_cryptographically_secure_random_string_here

# Google OAuth Settings
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
