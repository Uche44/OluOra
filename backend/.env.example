# Base Settings
ENVIRONMENT=dev
DEBUG=true

# Database Settings
# For local dev: postgresql+asyncpg://<username>:<password>@localhost:5432/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oluora

# Email settings
# Active provider: "resend" | "sendbyte" | "console" (console = log-only, no network).
# Swapping vendors is this variable plus a restart — no code change.
EMAIL_PROVIDER=resend
# Display name in the From header and the sender address (must be a verified domain).
EMAIL_FROM_NAME=OluOra
EMAIL_FROM_EMAIL=hello@mailing.useoluora.xyz
# Brand mark in the email masthead. Must be a public https URL: email clients fetch
# images server-side, so localhost or a relative path renders as a broken image.
EMAIL_LOGO_URL=https://www.useoluora.xyz/icons/logo.png
# Where replies go. Defaults to EMAIL_FROM_EMAIL when empty.
EMAIL_REPLY_TO=
# Public origin of the creator app, used to build links inside emails.
FRONTEND_URL=http://localhost:3000
# Public origin of this API (used for one-click unsubscribe links in emails).
API_PUBLIC_URL=http://localhost:8000

# Resend settings (https://resend.com) — required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=re_placeholder_key
RESEND_FROM_EMAIL=hello@mailing.useoluora.xyz

# Sendbyte Africa settings (https://sendbyte.africa) — required only when EMAIL_PROVIDER=sendbyte.
# Use a sandbox key (sk_test_) to capture mail without delivering it.
SENDBYTE_API_KEY=
SENDBYTE_BASE_URL=https://api.sendbyte.africa

# Bulk sending: throttle (messages/second) and hard cap per run, to respect
# provider rate limits and daily quotas.
EMAIL_MAX_PER_SECOND=2.0
EMAIL_BULK_MAX_PER_RUN=200

# Feedback reminders: minimum account age before a user is eligible, and the
# cooldown before the same user can be reminded again.
FEEDBACK_REMINDER_MIN_AGE_DAYS=3
FEEDBACK_REMINDER_COOLDOWN_DAYS=30

# Shared secret for the internal cron endpoint (POST /api/v1/internal/email/run).
# Send it in the X-Internal-Secret header. Empty disables the endpoint.
INTERNAL_CRON_SECRET=

# Allowed CORS origins (comma-separated list)
# The HTTPS tunnel origin used for OAuth callbacks MUST be listed here too: the
# provider redirects the browser to the tunnel (not localhost), so the callback
# page's request to this API carries the tunnel origin.
CORS_ORIGINS=http://localhost:3000

# Internal admin allowlist (comma-separated emails).
# Users with these emails are promoted to admin on startup and on login; removing
# an email demotes that user. Also add the admin dashboard origin to CORS_ORIGINS
# (e.g. http://localhost:3001 for local dev, https://admin.yourdomain.com in prod).
ADMIN_EMAILS=

# JWT Auth Settings
JWT_SECRET=super_secret_cryptographically_secure_random_string_here

# Google OAuth Settings
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# Separate redirect URI for "connect YouTube" (register both in Google Cloud Console)
GOOGLE_YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
# Callback for the isolated admin app's Google sign-in. Register it as another
# authorized redirect URI in Google Cloud Console.
GOOGLE_ADMIN_REDIRECT_URI=http://localhost:3001/auth/callback

# TikTok OAuth Settings (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
# TikTok requires an HTTPS, static redirect URI (no query params). Use a tunnel for local dev.
TIKTOK_REDIRECT_URI=https://your-tunnel-domain/auth/tiktok/callback
# Emails allowed to connect TikTok while it's in beta (comma-separated).
# Empty hides TikTok for everyone, including listed users.
TIKTOK_BETA_EMAILS=

# TikTok comment ingestion — ScrapeCreators (https://scrapecreators.com)
# TikTok's Display API exposes no comment endpoint to commercial apps, so public
# comments are sourced from this third-party provider. Billing is per request
# (one request returns one page of comments). Leave the key empty to keep TikTok
# videos metadata-only — comment analysis stays disabled for TikTok.
SCRAPECREATORS_API_KEY=
SCRAPECREATORS_BASE_URL=https://api.scrapecreators.com

# AI Integration Settings
# Groq API key for LLM chat completions (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Hugging Face API key for embedding generation (https://huggingface.co/settings/tokens)
HF_API_KEY=your_huggingface_api_key_here
# Embedding model — BAAI/bge-small-en-v1.5 outputs 384-dimensional vectors
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Comments sent to the LLM per cluster, and sub-groups used for large clusters.
ANALYSIS_SAMPLES_PER_CLUSTER=20
ANALYSIS_SUBCLUSTERS=6
